# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- DEPENDENCIES ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- TESTING ---
/coverage

# --- NEXT.JS ---
/.next/
/out/

# --- PRODUCTION ---
/build

# --- MISC ---
.DS_Store
*.pem
Thumbs.db
*.log

# --- DEBUG LOGS ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- ENVIRONMENT FILES (KEEP SECRETS OUT OF GIT) ---
#
# This project stores API keys, DB credentials, and the dashboard password in
# local env files. NEVER commit these. The example file (.env.local.example) is
# intentionally kept so new contributors know which variables to populate.
#
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production
.env.test
#
# >>> DO NOT DELETE THIS LINE <<<
# Example template — safe to commit (contains no real values):
!.env.local.example

# --- VERCEL ---
.vercel

# --- TYPESCRIPT ---
*.tsbuildinfo
next-env.d.ts

# --- EDITOR / IDE ---
.vscode/
.idea/
*.swp
*.swo
